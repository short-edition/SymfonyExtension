{
    "name": "short-edition/symfony-extension",
    "type": "symfony-bundle",
    "description": "Integrates Behat with Symfony.",
    "license": "MIT",
    "authors": [
        {
            "name": "Kamil Kokot",
            "email": "kamil@kokot.me",
            "homepage": "https://kamilkokot.com"
        }
    ],
    "require": {
        "php": ">= 8.5",
        "behat/behat": "4.x-dev",
        "symfony/dependency-injection": "^8",
        "symfony/http-kernel": "^8"
    },
    "require-dev": {
        "behat/mink-browserkit-driver": "^2.3",
        "behat/mink-selenium2-driver": "^1.7",
        "behat/mink": "^1.13",
        "short-edition/mink-extension": "dev-bugfix",
        "friends-of-behat/page-object-extension": "^0.4",
        "sylius-labs/coding-standard": "^4.5",
        "symfony/browser-kit": "^8",
        "symfony/framework-bundle": "^8",
        "symfony/process": "^8",
        "symfony/yaml": "^8",
        "vimeo/psalm": "^6.16"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.2-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "FriendsOfBehat\\SymfonyExtension\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": [
            "@composer validate --ansi --strict",
            "vendor/bin/ecs check --ansi --no-progress-bar src tests || true",
            "vendor/bin/psalm src --no-progress"
        ],
        "fix": [
            "vendor/bin/ecs check --ansi --no-progress-bar src tests --fix"
        ],
        "test": [
            "vendor/bin/behat -f progress --strict -vvv --no-interaction --colors"
        ]
    }
}
